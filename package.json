{
  "name": "offline-pdf-compressor",
  "version": "1.0.0",
  "description": "Offline PDF compressor desktop app",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"wait-on http://127.0.0.1:5173 && npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "electron .",
    "build": "tsc && vite build",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^32.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.10"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "concurrently": "^9.0.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.2",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.offline.pdfcompressor",
    "productName": "Offline PDF Compressor",
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "win": {"target": "nsis"}
  }
}